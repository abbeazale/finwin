# Daily Massive download: new minute and daily bars, then the float change log.
# A run fails while Massive has not published the last session, and systemd
# starts it again every hour until it succeeds.
[Unit]
Description=FinWin market-data daily ingest
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=finwin
WorkingDirectory=/opt/finwin
EnvironmentFile=/etc/finwin-market-data.env
ExecStart=/usr/local/bin/bun market-data/src/ingest.ts daily
Restart=on-failure
RestartSec=1h
