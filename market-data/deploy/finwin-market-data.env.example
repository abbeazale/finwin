# Copy to /etc/finwin-market-data.env (mode 600, owned by root).
MARKET_DATA_DATABASE_URL=postgres://finwin@localhost/finwin_market
MASSIVE_API_KEY=
# Same value as FinWin's MARKET_DATA_TOKEN. Generate: openssl rand -hex 32
MARKET_DATA_TOKEN=
MARKET_DATA_ARCHIVE=/var/lib/finwin-market-data/raw
MARKET_DATA_HOST=127.0.0.1
MARKET_DATA_PORT=8787
