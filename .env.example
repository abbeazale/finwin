# Deployment contract — local | preview | staging | production
FINWIN_ENV=local
DATABASE_ENVIRONMENT=local

# App origin and Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_API_KEY=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Current version first; retain older versions during rotation
BETTER_AUTH_SECRETS=1:base64-32-byte-key

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional convenience; the app uses DATABASE_URL
NEON_DB_PASSWORD=
DATABASE_URL=

# Plaid — sandbox | development | production
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_TOKEN_ENCRYPTION_CURRENT_KEY_VERSION=v1
# Generate with: openssl rand -base64 32
PLAID_TOKEN_ENCRYPTION_KEYS={"v1":"base64-32-byte-key"}
# Public https URL Plaid will POST webhooks to (use ngrok in dev)
PLAID_WEBHOOK_URL=

# Optional — Open Exchange Rates for investment USD aggregation
OER_KEY=
# Optional bearer token for POST /api/internal/fx/refresh
FX_REFRESH_SECRET=

# Optional — Finnhub for landing ticker and sandbox quotes/search
FINNHUB_API_KEY=
